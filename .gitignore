# ── 敏感 / 本机配置（绝不提交）──────────────────────────
# AI key 所在的本机覆盖文件：gitignore 保护 + .example 模板进仓库
docker-compose.override.yml

# 服务器连接凭据与部署辅助脚本（本机专用，内容绝不入库）
local/

# APK 签名密钥库与密码（丢失 = 无法发更新，务必备份；密码记在 local/creds.md）
report-web/android/app/aischool.keystore
report-web/android/keystore.properties
# 签名后的发布 APK 产物（交付件不走 git）
report-web/android/app/release/

# ── 依赖与构建产物 ─────────────────────────────────────
**/node_modules/
**/dist/
**/target/
tools/npm-cache/
tools/apache-maven-3.9.16/

# 本机 maven 依赖仓库（111MB 构建加速缓存）：仓库只留目录占位，
# 克隆后 docker build 自动从阿里云拉取（首次构建较慢，属预期）
tools/m2-repo/*
!tools/m2-repo/.gitkeep

# ── 运行时产物 / 日志 / QA 过程文件 ────────────────────
**/*.log
report-web/e2e/shots/
report-web/e2e/_*.mjs
report-web/e2e/_*.sql

# ── 不入库的本机参考 / 过程文档 ────────────────────────
功能点.md
学生成长报告册.pdf

# ── 系统杂物 ──────────────────────────────────────────
.DS_Store
Thumbs.db
backups/
__pycache__/

# 本机 Maven 本地仓库指向 tools/m2-repo（勿写 C 盘 ~/.m2）——不入库，fork 者用默认即可
report-server/settings.xml
# 提示词评测输出（过程产物）
report-server/scripts/prompt_eval_out/

# 石实换校素材中转（原始素材不入库）
shishi-assets/

# App 化 QA 截图（过程产物）
report-web/shots/

# App 改版设计参考图（本机参考，不入库）
new/

# 内部总说明与使用手册（公开仓库不放，本地交付；手册含验收账号故不入库）
项目说明.md
使用手册.md
使用手册.pdf
交付交接手册.md
交付交接手册.pdf
从零看懂-面试准备.md

